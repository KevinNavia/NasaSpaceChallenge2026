# NASA Space Apps - StellarApp | Variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

PORT=8000

# --- IA ---
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=8
OLLAMA_NUM_PREDICT=300

# --- Telegram (obtén el token con @BotFather; si se filtró, usa /revoke) ---
TELEGRAM_BOT_TOKEN=
# Secreto aleatorio para validar el webhook (ej: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# --- Seguridad ---
# Clave para rutas administrativas y telemetría de hardware (header X-API-Key).
# Genera una con: openssl rand -hex 32   (vacía = rutas abiertas, solo desarrollo)
STELLAR_API_KEY=
# Orígenes CORS permitidos, separados por coma
ALLOWED_ORIGINS=https://stellarapp.nerosystem.solutions,http://localhost:3000
# 1 si estás detrás de Nginx/Cloudflare (lee la IP real de X-Forwarded-For)
TRUST_PROXY_HEADERS=0
LOG_LEVEL=INFO
